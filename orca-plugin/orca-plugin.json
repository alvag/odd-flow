{
  "manifestVersion": 2,
  "id": "odd-flow-profiles",
  "name": "odd-flow profiles",
  "version": "0.1.0",
  "description": "View and switch the odd-flow profile and mode for agent sessions in the focused workspace.",
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "commands": [
      {
        "id": "odd-flow.openProfiles",
        "title": "odd-flow: Open profiles panel"
      },
      {
        "id": "odd-flow.toggleMode",
        "title": "odd-flow: Toggle mode"
      }
    ],
    "keybindings": [
      {
        "command": "odd-flow.openProfiles",
        "key": "Mod+Alt+Shift+O"
      }
    ],
    "events": [
      { "on": "agent.status.changed" },
      { "on": "workspace.changed" }
    ],
    "statusBarItems": [
      {
        "id": "odd-flow-status",
        "text": "odd",
        "tooltip": "Open the odd-flow profiles panel",
        "command": "odd-flow.openProfiles"
      }
    ],
    "panels": [
      {
        "id": "odd-flow-profiles",
        "title": "odd-flow profiles",
        "icon": "agent",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "settings": [
      {
        "key": "profileScript",
        "title": "Profile script",
        "description": "Absolute path to a trusted odd-flow profile.py. Leave blank to detect an installed copy.",
        "type": "string",
        "default": ""
      },
      {
        "key": "pluginKey",
        "title": "Plugin key",
        "description": "Installed key used to open the profiles panel. Leave blank to detect the single enabled odd-flow profiles plugin.",
        "type": "string",
        "default": ""
      }
    ]
  },
  "capabilities": [
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "settings:own"
    }
  ]
}
