{
  "manifestVersion": 2,
  "id": "odd-flow-profiles",
  "name": "odd-flow profiles",
  "version": "0.1.0",
  "description": "View and switch the odd-flow profile and mode for agent sessions in the focused workspace.",
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "odd-flow-profiles",
        "title": "odd-flow profiles",
        "icon": "agent",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "settings": [
      {
        "key": "profileScript",
        "title": "Profile script",
        "description": "Absolute path to a trusted odd-flow profile.py. Leave blank to detect an installed copy.",
        "type": "string",
        "default": ""
      }
    ]
  },
  "capabilities": [
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "settings:own"
    }
  ]
}
