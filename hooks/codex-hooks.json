{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${PLUGIN_ROOT}/scripts/session-start.py\" --runtime codex",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${PLUGIN_ROOT}/scripts/prompt-submit.py\" --runtime codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|spawn_agent|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${PLUGIN_ROOT}/scripts/pre-tool-use.py\" --runtime codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
